# Public interfaces only. Internals, everything marked @private and the
# extension's Kino::Native, are deliberately unsigned: they are
# implementation detail and may change without notice.
module Kino
  VERSION: String

  # Any Rack 3 application: responds to #call(env) with [status, headers, body].
  type rack_app = untyped

  type stats_hash = Hash[Symbol, untyped]

  class Error < StandardError
  end

  # Raised when mode: :ractor is forced but the app is not Ractor-shareable.
  class UnshareableAppError < Error
  end

  # Raised by a streaming body's write once its client has gone.
  class ClientGone < IOError
  end

  # High-resolution sleep on the OS clock with the GVL released.
  def self.sleep: (Numeric seconds) -> nil

  # CPUs this process may use (affinity mask and cgroup quota); never below 1.
  def self.available_parallelism: () -> Integer

  # RUBY_MAX_CPU as Ruby reads it: 8 when unset or not an integer.
  def self.ruby_max_cpu: () -> Integer

  class Server
    attr_reader port: Integer?
    attr_reader control_port: Integer?
    attr_reader mode: Symbol
    attr_reader bind: String

    def tls?: () -> bool

    # Whether the bind is a unix domain socket ("unix:///path/to.sock").
    def unix?: () -> bool

    # Where the server listens once started: http(s)://host:port or the
    # unix:// socket path.
    def url: () -> String

    # Where the control plane listens once started, or nil when it is off.
    def control_url: () -> String?

    # Settings precedence: explicit kwargs > config_file DSL > defaults.
    def initialize: (rack_app app, ?config_file: String?, **untyped options) -> void

    def start: () -> self

    # Graceful shutdown: drain to the deadline, then abort stragglers.
    def shutdown: (?timeout: Numeric?) -> nil

    # Block until a shutdown has ended; raises its error if it failed.
    def wait: () -> void

    # Live snapshot: config echo plus native counters (queued, in_flight,
    # served, rejected, timeouts, respawns, ...), in the order /stats lists
    # them; :responses_cut and :websockets cover the whole process.
    def stats: () -> stats_hash

    # Production entry point: build the server and #run it.
    def self.run: (rack_app app, ?credits: bool, ?on_ready: (^() -> void)?, **untyped opts) -> Server

    # Serve until shut down: start, banner, signal traps, block until done.
    def run: (?credits: bool, ?on_ready: (^() -> void)?) -> self

    # INT/TERM drain gracefully (second signal force-exits); USR1 prints stats.
    def self.trap_signals: (Server server) -> void
  end

  class Configuration
    DEFAULTS: Hash[Symbol, untyped]
    SETTINGS: Array[Symbol]
    SAMPLE_TEMPLATE: String
    DEFAULT_PATHS: Array[String]
    DEFAULT_SERVING_PORT: Integer

    # The first of DEFAULT_PATHS (kino.rb, config/kino.rb) present in the
    # working directory.
    def self.default_path: () -> String?

    # The fully commented sample config (see `kino --init`).
    def self.sample: () -> String

    # Write the sample config to path; raises Kino::Error if it exists
    # unless force. Returns the path.
    def self.write_sample: (String path, ?force: bool) -> String

    def initialize: () -> void

    def []: (Symbol key) -> untyped

    # Raises ArgumentError for keys outside DEFAULTS.
    def set: (Symbol key, untyped value) -> untyped

    def set?: (Symbol key) -> bool

    # Evaluate a Puma-style Ruby DSL config file into this configuration.
    def load_file: (String path) -> self

    def merge!: (Hash[Symbol, untyped] options) -> self

    def to_h: () -> Hash[Symbol, untyped]

    # to_h minus the CLI-only keys (:rackup, :environment); what Server.new
    # accepts.
    def server_options: () -> Hash[Symbol, untyped]

    # The config-file DSL: one method per directive.
    class DSL
      def initialize: (Configuration config) -> void

      def bind: (String host) -> untyped
      def port: (int port) -> untyped
      def workers: (int count) -> untyped
      def max_workers: (int count) -> untyped
      def scale_down_after: (Numeric seconds) -> untyped
      def threads: (int count) -> untyped
      def mode: (Symbol | String mode) -> untyped
      def queue_depth: (int depth) -> untyped
      def queue_timeout: (Numeric seconds) -> untyped
      def request_timeout: (Numeric? seconds) -> untyped
      def max_connections: (int count) -> untyped
      def max_body_size: (int? bytes) -> untyped
      def batch: (int count) -> untyped
      # Per-worker lanes (default: on with a worker_loop, else off); native WebSockets and wake
      # hooks need them.
      def lanes: (boolish enabled) -> untyped
      # Largest message a client may send (default 1 MiB); past it, 1009.
      def websocket_max_message: (int bytes) -> untyped
      # Most native sockets open at once (default nil: no cap of its own).
      def websocket_max: (int? count) -> untyped
      # Seconds of silence before a ping (default 30); nil or 0: no pings.
      def websocket_ping_interval: (Numeric? seconds) -> untyped
      def log_requests: (boolish enabled) -> untyped
      def on_error: (?^(Exception, Hash[String, untyped]) -> void handler) ?{ (Exception, Hash[String, untyped]) -> void } -> untyped
      def after_boot: (?^() -> void handler) ?{ () -> void } -> untyped
      def after_worker_boot: (?^(Integer) -> void handler) ?{ (Integer) -> void } -> untyped
      def after_request_complete: (?^(Hash[String, untyped], Integer) -> void handler) ?{ (Hash[String, untyped], Integer) -> void } -> untyped
      def on_worker_exit: (?^(Integer, Exception?) -> void handler) ?{ (Integer, Exception?) -> void } -> untyped
      def worker_loop: (?^(Worker::Loop) -> void handler) ?{ (Worker::Loop) -> void } -> untyped
      def shutdown_timeout: (Numeric seconds) -> untyped
      def io_shards: (?boolish enabled) -> untyped
      def io_threads: (int count) -> untyped
      def tokio_threads: (int count) -> untyped
      def tls: (cert: String, key: String) -> untyped
      def http2: (?boolish enabled) -> untyped
      def environment: (String | Symbol env) -> untyped
      def pidfile: (String path) -> untyped
      def control_bind: (String addr) -> String
      def control_token: (String token) -> String
      def quarantine_timeout: (Numeric? seconds) -> untyped
      def quarantine_max: (int count) -> untyped
      def rackup: (String path) -> untyped
    end
  end

  # A handle to a native WebSocket, handed to the callbacks of the handler an app sets as
  # env["rack.upgrade"]: frozen, shareable, and usable from any thread or Ractor.
  class WebSocket
    attr_reader id: Integer

    # The socket with this id; nil once it is gone.
    def self.[]: (Integer id) -> WebSocket?

    def ==: (untyped other) -> bool

    def eql?: (untyped other) -> bool

    def hash: () -> Integer

    # One text frame.
    def write: (String data) -> bool

    # One binary frame.
    def write_binary: (String data) -> bool

    # Bytes that already form complete frames.
    def write_raw: (String frames) -> bool

    # A close frame after what is queued (5 s to answer); the first close stands, on_close
    # follows. False on a full queue; ArgumentError for a code no endpoint may send.
    def close: (?Integer code) -> bool

    # Drop the connection now; on_close follows.
    def abort: () -> bool

    # Data frames queued and not yet written; 0 once the socket is gone.
    def pending: () -> Integer

    # Receive `topic`'s publishes as `prefix + body + suffix` frames; a full queue drops the
    # socket (:close) or skips the message (:skip). False once gone.
    def subscribe: (String topic, ?prefix: String, ?suffix: String, ?when_full: :close | :skip) -> bool

    # End every subscription to `topic`, or those made with `prefix`; false if none.
    def unsubscribe: (String topic, ?prefix: String?) -> bool

    # Queue `body` for `topic`'s subscribers from any Ractor, as text (UTF-8) or binary; false
    # only when the fan-out queue is full.
    def self.publish: (String topic, String body, ?binary: boolish) -> bool
  end

  # The worker's wake hook: work on the worker's own thread (::on_wake). Needs lanes.
  class Worker
    # Register (or replace) this worker thread's hook; ArgumentError off a worker thread.
    def self.on_wake: () { () -> void } -> Waker

    # Wakes one worker, from any thread or Ractor (frozen, shareable).
    class Waker
      # The hook runs soon; wakes before it coalesce. False once the worker has exited or is
      # retiring, or without lanes.
      def wake: () -> bool
    end

    # What a worker_loop gets: Kino's loop, for the app's fiber scheduler to run.
    class Loop
      # Serve the worker's requests as jobs the block starts, at most `concurrency` at a time;
      # each socket's events, and the wakes, run in order on jobs of their own. Returns once the
      # worker is drained.
      def serve: (concurrency: Integer) { (^() -> void job) -> void } -> nil
    end
  end

  # The `kino` executable plus startup presentation shared with Server.run.
  module CLI
    MOTD: String

    # Parse argv, then init/check/serve. Returns the process exit status
    # (-v and -h print and exit in place per optparse convention).
    def self.start: (Array[String] argv) -> Integer

    # True when output to io may use ANSI styling.
    def self.color?: (?IO io) -> bool

    # Wrap text in an SGR code, resetting at the end; plain on non-color io.
    def self.paint: (String code, String text, ?io: IO) -> String

    def self.dim: (String text, ?io: IO) -> String

    def self.bold: (String text, ?io: IO) -> String

    def self.red: (String text, ?io: IO) -> String

    # The banner with a vertical grayscale gradient.
    def self.motd: (?color: bool) -> String

    # One-line stats dump (the SIGUSR1 handler's output).
    def self.stats_line: (stats_hash stats) -> String

    # The two banner halves around Server#start.
    def self.opening_credits: () -> void
    def self.action!: (Server server) -> void

    # Print a bold "Fin." when the process ends (idempotent).
    def self.fin_at_exit: () -> void
  end

  # The shareability doctor behind `kino --check`.
  module Check
    MAX_FINDINGS: Integer
    MAX_NODES: Integer

    class Finding < ::Struct[untyped]
      attr_accessor path: String
      attr_accessor message: String

      def to_s: () -> String
    end

    def self.report: (rack_app app) -> { shareable: bool, findings: Array[Finding] }

    # Pretty-printed report; true when the app is ractor-ready.
    def self.print_report: (rack_app app, ?io: IO) -> bool
  end

  # Server log lines, `kino[<pid>] <source>: message`; safe inside worker
  # ractors, so hooks may log through it.
  module Log
    FRAMES: Integer
    WORKING_DIR: String

    def self.info: (untyped message) -> void
    def self.warn: (untyped message) -> void
    def self.error: (untyped message) -> void

    # The failed-request report: request line, error, and an app-first
    # backtrace relative to the working directory.
    def self.exception: (Exception error, Hash[String, untyped] env, ?status: Integer) -> void

    # The `kino[<pid>] <source>:` tag.
    def self.label: () -> String

    # The ractor and/or thread name, or `main`.
    def self.source: () -> String
  end

  # A ::Logger writing through the native async sink.
  class Logger < ::Logger
    # path: a file (created/appended) or nil for stdout.
    def initialize: (?String? path, **untyped options) -> void

    # The raw IO-like device: frozen and Ractor-shareable, one device can
    # serve every worker.
    class Device
      def initialize: (?String? path) -> void

      def write: (untyped message) -> void

      alias << write

      def close: () -> void

      def reopen: (*untyped) -> self
    end
  end
end

module Rackup
  module Handler
    # The Rack handler behind `rackup -s kino` and `rails server -u kino`.
    module Kino
      # Boot a server for app and block until shutdown; yields the built,
      # not yet started server to hosts that want a handle on it.
      def self.run: (::Kino::rack_app app, **untyped options) ?{ (::Kino::Server) -> void } -> ::Kino::Server

      # The -O options rackup lists for this handler.
      def self.valid_options: () -> Hash[String, String]

      # Host options translated into Kino::Server kwargs, with precedence
      # typed > config file > host defaults > Kino defaults.
      def self.server_options: (Hash[Symbol, untyped] options) -> Hash[Symbol, untyped]
    end
  end
end
